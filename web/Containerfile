FROM quay.io/fedora/fedora:44 AS build
RUN dnf -y install nodejs nodejs-npm && dnf clean all
RUN npm install --global pnpm@12.14.0
WORKDIR /src
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY web/package.json ./web/package.json
RUN pnpm install --frozen-lockfile
COPY web ./web
RUN pnpm build

# Static-asset convenience server for local testing; deploy /srv to a CDN in production.
FROM quay.io/fedora/fedora-minimal:44
RUN microdnf -y install nginx && microdnf clean all
COPY web/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /src/web/dist /srv
USER 65532:65532
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
