<?xml version="1.0" encoding="utf-8"?>
<!-- No backups: settings are a URL and a few toggles, quickly re-entered. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
