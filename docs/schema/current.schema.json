{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "location": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ]
    },
    "generated_at": {
      "type": "number",
      "minimum": 0
    },
    "expires_at": {
      "type": "number",
      "minimum": 0
    },
    "services": {
      "maxItems": 500,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "hidden": {
            "type": "boolean"
          },
          "hosting_location": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "healthy",
              "down",
              "unknown"
            ]
          },
          "observed_at": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "expires_at": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "duration_seconds": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "name",
          "hidden",
          "hosting_location",
          "status",
          "observed_at",
          "expires_at",
          "duration_seconds"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "location",
    "generated_at",
    "expires_at",
    "services"
  ]
}
