{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "number",
          "const": 2
        },
        "kind": {
          "type": "string",
          "const": "probes"
        },
        "location": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "name": {
              "type": "string"
            }
          },
          "required": [
            "id",
            "name"
          ]
        },
        "generated_at": {
          "type": "number",
          "minimum": 0
        },
        "expires_at": {
          "type": "number",
          "minimum": 0
        },
        "window_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scrape_interval_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "refresh_seconds": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "services": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "hidden": {
                "type": "boolean"
              },
              "requires_vpn": {
                "type": "boolean"
              },
              "hosting_location": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "labels": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32,
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^\\P{Cc}*$"
                },
                "maxProperties": 16
              },
              "observed_success_ratio": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "coverage": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "probes": {
                "maxItems": 3610,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "at": {
                      "type": "number",
                      "minimum": 0
                    },
                    "success": {
                      "type": "boolean"
                    },
                    "http_status_code": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 100,
                          "maximum": 599
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  },
                  "required": [
                    "at",
                    "success",
                    "http_status_code"
                  ]
                }
              }
            },
            "required": [
              "id",
              "name",
              "hidden",
              "hosting_location",
              "observed_success_ratio",
              "coverage",
              "probes"
            ]
          }
        }
      },
      "required": [
        "schema_version",
        "kind",
        "location",
        "generated_at",
        "expires_at",
        "window_seconds",
        "scrape_interval_seconds",
        "refresh_seconds",
        "services"
      ]
    },
