FROM quay.io/fedora/fedora:44 AS build
RUN dnf -y install rust cargo gcc openssl-devel && dnf clean all
WORKDIR /src
COPY Cargo.toml Cargo.lock ./
COPY publisher ./publisher
RUN cargo build --locked --release -p beacon-publisher

FROM quay.io/fedora/fedora-minimal:44
RUN microdnf -y install ca-certificates && microdnf clean all
COPY --from=build /src/target/release/beacon-publisher /usr/local/bin/beacon-publisher
USER 65532:65532
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/beacon-publisher"]
